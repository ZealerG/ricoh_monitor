# 理光映像 GR 商品监控 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值，或直接设置环境变量

# SMTP 邮件配置
SMTP_SERVER=smtp.126.com
SMTP_PORT=465
SMTP_USER=your_email@126.com
SMTP_PASSWORD=your_smtp_password

# 收件人列表（逗号分隔）
# 第一个收件人会额外接收脚本运行异常的诊断邮件
RECEIVER_EMAILS=email1@qq.com,email2@qq.com,email3@126.com

# 监控配置
CID=9
KEYWORD=GR
KEYWORDS=GR III,GR IIIx,HDF
EXCLUDE_KEYWORDS=RING,金圈,配件
MATCH_MODE=any
NOTIFY_ZERO_STOCK=false
STATE_PATH=./ricoh_email_monitor.state.json
POLL_INTERVAL=30
